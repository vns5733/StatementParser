  "cards": [
    {
      "dot": "cyan",
      "title": "Flow 1 - Ingestion (upload and load-sample)",
      "items": [
        "POST /api/transactions/upload reads the UploadFile into BytesIO, rejects any extension outside .xls .xlsx .csv .pdf",
        "POST /api/transactions/load-sample resolves DEFAULT_STATEMENT_PATH then the newest file in masked/",
        "Both then call load_and_clean_statement, parse_narrations_dataframe and store_data_in_db in that order",
        "store_data_in_db calls init_db_tables then writes both frames with INSERT IGNORE, so re-imports never duplicate"
      ]
    },
    {
      "dot": "emerald",
      "title": "Flow 2 - Read path (11 GET endpoints)",
      "items": [
        "list, meta, kpis, timeline, monthly-category, category-breakdown, balance-trend, category-trend, export, health",
        "All of them call get_all_transactions_with_details, which returns a copy of the cached final frame",
        "_get_filtered_df applies year, month, txn type, category, sub-category, search, amount, direction and recurrence in Pandas",
        "No SQL-level filtering exists, so each request re-reads the whole table and aggregates in memory"
      ]
    },
    {
      "dot": "violet",
      "title": "Flow 3 - Recategorize",
      "items": [
        "POST /api/transactions/recategorize calls recategorize_all_narrations and returns old_counts plus new_counts",
        "Every stored narration is re-parsed and narration_details is rebuilt with the current parser rules",
        "category_rules rows are untouched and simply re-applied at read time, so user edits survive",
        "The transaction cache is invalidated at the end, making the change visible on the next request"
      ]
    },
    {
      "dot": "amber",
      "title": "Flow 4 - Category rules and cascade",
      "items": [
        "POST /api/categories/rules upserts rules; /rules/delete removes them by rule_type and rule_key",
        "apply-cascade previews matches, then pins every excluded row with a synthetic txn rule at its current category AND leaf",
        "Stale txn overrides on included rows are cleared so the broader merchant or narration rule takes effect",
        "Only the rules cache and the final frame are invalidated; the stored transactions are never rewritten"
      ]
    },
    {
      "dot": "rose",
      "title": "Flow 5 - Export",
      "items": [
        "GET /api/transactions/export reuses the same _get_filtered_df as the tables, so exports match the screen",
        "Dates are normalised to %Y-%m-%d and the frame is encoded utf-8-sig so Excel opens it correctly",
        "The filename comes from Content-Disposition and the whole filtered set streams, not the visible page"
      ]
    },
    {
      "dot": "slate",
      "title": "Cache contract and constraints",
      "items": [
        "_CACHE_LOCK makes a cold start single-flight, so 11 concurrent dashboard requests run one query",
        "invalidate_transaction_cache drops base+final; invalidate_rules_cache drops rules+final; invalidate_caches drops both",
        "Any write outside the API is invisible until restart; there is no test suite, requirements.txt or git repository"
      ]
    }
  ]
